generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String           @id @default(cuid())
  name               String?
  email              String?          @unique
  emailVerified      DateTime?
  image              String?
  // Opt-in: expose a read-only watchlist at /u/<id>
  publicWatchlist    Boolean          @default(false)
  // Opt-in: email when a saved title newly hits a streaming service
  streamAlerts       Boolean          @default(false)
  // Region and provider ids from TMDB/JustWatch power "available for me".
  watchRegion        String           @default("US")
  preferredProviders Int[]            @default([])
  accounts           Account[]
  sessions           Session[]
  watchList          WatchListItem[]
  watchEvents        WatchEvent[]
  movieLists         MovieList[]
  votingRooms        MovieNightRoom[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WatchListItem {
  id                  String   @id @default(cuid())
  userId              String
  movieId             String
  directedBy          String
  durationMinutes     Int
  name                String
  emsVersionId        String
  posterImage         String?
  genres              String[]
  synopsis            String?
  tomatoMeter         Int?
  consensus           String?
  totalGross          String?
  releaseDate         String?
  motionPictureRating String?
  userRating          Int?
  // Last-known streaming availability, so the alerts job can detect the
  // transition from "not streaming" to "streaming" (see api/cron/availability)
  hasStreaming        Boolean  @default(false)
  user                User     @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
}

/// One row per viewing, so rewatches can keep their own date, rating, review,
/// and context tags instead of overwriting a single movie-level value.
model WatchEvent {
  id              String   @id @default(cuid())
  userId          String
  movieId         String
  name            String
  posterImage     String?
  releaseDate     String?
  durationMinutes Int      @default(0)
  genres          String[] @default([])
  rating          Int?
  review          String?
  tags            String[] @default([])
  watchedAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([userId, movieId])
}

model MovieList {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       MovieListItem[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model MovieListItem {
  id          String    @id @default(cuid())
  listId      String
  movieId     String
  name        String
  posterImage String?
  releaseDate String?
  tomatoMeter Int?
  position    Int       @default(0)
  addedAt     DateTime  @default(now())
  list        MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, movieId])
  @@index([listId, position])
}

model MovieNightRoom {
  id         String                @id @default(cuid())
  hostId     String
  shareCode  String                @unique
  name       String
  filters    Json
  createdAt  DateTime              @default(now())
  expiresAt  DateTime
  host       User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  candidates MovieNightCandidate[]

  @@index([hostId, createdAt])
}

model MovieNightCandidate {
  id          String           @id @default(cuid())
  roomId      String
  movieId     String
  name        String
  posterImage String?
  releaseDate String?
  tomatoMeter Int?
  position    Int              @default(0)
  room        MovieNightRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes       MovieNightVote[]

  @@unique([roomId, movieId])
  @@index([roomId, position])
}

model MovieNightVote {
  id          String              @id @default(cuid())
  candidateId String
  voterToken  String
  voterName   String
  liked       Boolean
  createdAt   DateTime            @default(now())
  candidate   MovieNightCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, voterToken])
  @@index([candidateId, liked])
}
